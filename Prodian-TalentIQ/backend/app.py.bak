       'fields':[{'name':'skills','label':'Required skills','type':'text'},
         {'name':'min_years','label':'Minimum years','type':'number','min':0},
         {'name':'max_years','label':'Maximum years','type':'number','min':0},
         {'name':'location','label':'Location','type':'text'}],
       'requires_approval_for_write':True,'source':'TalentIQ static schema; proposed as TELA Assist dynamic form reference'}


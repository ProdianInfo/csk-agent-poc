class ApprovalRequest(BaseModel):incident_id:int
@app.post('/api/ops/reprocess/prepare')
def prepare_reprocess(body:ApprovalRequest,user=Depends(hr)):
    with connect() as con:
        if not one(con,'SELECT id FROM incidents WHERE id=?',(body.incident_id,)):
            raise HTTPException(404,'Incident not found')
        cur=con.execute('INSERT INTO approvals(action,target_id,requested_by) VALUES(?,?,?)',
            ('mark_incident_resolved',body.incident_id,actor_label(user)))
        id=cur.lastrowid
    audit(actor_label(user),'request_resolution_approval',str(id))
    return {'approval_id':id,'status':'pending','action':'mark_incident_resolved'}
@app.post('/api/ops/reprocess/{approval_id}/approve')
def approve(approval_id:int,user=Depends(admin)):
    with connect() as con:
        item=one(con,'SELECT * FROM approvals WHERE id=?',(approval_id,))
        if not item or item['status']!='pending':raise HTTPException(409,'Approval not pending')
        if item['requested_by']==user['user']:raise HTTPException(403,'Four-eyes approval: requester cannot self-approve')
        con.execute("UPDATE approvals SET status='approved',approved_by=? WHERE id=?",(actor_label(user),approval_id))
    audit(actor_label(user),'approve_resolution',str(approval_id))
    return {'status':'approved'}
@app.post('/api/ops/reprocess/{approval_id}/execute')
def execute_reprocess(approval_id:int,user=Depends(admin)):
    with connect() as con:
        item=one(con,'SELECT * FROM approvals WHERE id=?',(approval_id,))
        if not item or item['status']!='approved' or item['action']!='mark_incident_resolved':
            raise HTTPException(403,'Approved action required')
        con.execute("UPDATE incidents SET status='resolved' WHERE id=?",(item['target_id'],))
        con.execute("UPDATE approvals SET status='executed' WHERE id=?",(approval_id,))
    audit(actor_label(user),'execute_approved_resolution',str(approval_id))
    return {'status':'executed','effect':'Synthetic incident status changed to resolved; no operational retry performed'}

# TELA tool gateway: deliberately explicit authorization, never implicit TELA access to DB.
def tela_auth(request:Request):
    supplied=request.headers.get('x-tela-service-key','')
    if not TELA_KEY or not hmac.compare_digest(supplied,TELA_KEY):
        raise HTTPException(403,'TELA service key not configured or invalid')
    return True
class CandidateSearchTool(BaseModel):
    skills:str=''
    min_years:float=0
    max_years:float|None=None
    location:str=''
    limit:int=Field(default=10,ge=1,le=25)
@app.post('/api/tela/tools/search-candidates')
def tela_candidate_search(body:CandidateSearchTool,ok=Depends(tela_auth)):
    # Tool is redacted by default: PII should NOT be sent to the LLM.
    with connect() as con: values=rows(con,'SELECT * FROM candidates ORDER BY id DESC LIMIT 2000')
    output=[]
    for c in values:
        match=rank_candidate(c,body.skills,body.min_years,body.max_years,body.location)
        if body.skills and not match['matched_skills']:continue
        output.append({'candidate_id':c['id'],'candidate_ref':f"TQ-{c['id']:05d}",
          'years':c['years'],'skills':split_skills(c['skills']),
          'location':c['location'],'status':c['status'],**match})
    output.sort(key=lambda x:x['score'],reverse=True)
    audit('tela-service','candidate_search_tool','read-only',f'{min(body.limit,len(output))} results')
    return {'items':output[:body.limit],'pii_policy':'name, phone and email intentionally excluded; resolve in TalentIQ HR UI'}
@app.get('/api/tela/tools/application-map')
def tela_appmap(ok=Depends(tela_auth)):
    return {'application':'Prodian TalentIQ','capabilities':['resume_ingestion','ocr','search','ranking','pipeline'],
       'modules':DEPENDENCIES,'read_only_tools':['search-candidates','application-map'],
       'limitations':['No live TELA binding supplied','No autonomous unrestricted remediation']}


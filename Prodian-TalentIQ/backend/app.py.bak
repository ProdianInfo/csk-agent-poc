   'business_impact':'Interview lifecycle cannot be updated'}}

@app.get('/api/ops/dependency-map')
def dependency_map(user=Depends(current_user)):return DEPENDENCIES

FAULTS={'resume_parser_error':('Resume OCR extraction failure','high','resume_import'),
        'search_500':('Candidate search HTTP 500','critical','candidate_search'),
        'search_latency':('Candidate search latency exceeds SLO','medium','candidate_search'),
        'schema_drift':('Candidate skills column mismatch','high','candidate_search')}
class FaultInput(BaseModel):kind:str
@app.post('/api/ops/inject')
def inject_fault(body:FaultInput,user=Depends(admin)):
    if os.getenv('TALENTIQ_LAB_MODE','true').lower()!='true':raise HTTPException(403,'Lab mode disabled')
    if body.kind not in FAULTS:raise HTTPException(422,'Unknown lab fault')
    title,severity,module=FAULTS[body.kind]
    trace=str(uuid.uuid4())
    details={'fault':body.kind,'component':module,'affected':DEPENDENCIES[module],
       'evidence':'LAB_INJECTED; synthetic test incident, not actual production failure'}
    with connect() as con:
        cur=con.execute('INSERT INTO incidents(kind,title,severity,trace_id,details) VALUES(?,?,?,?,?)',
          (body.kind,title,severity,trace,json.dumps(details)))
        id=cur.lastrowid
    logger.error('lab_fault trace=%s incident_id=%s kind=%s component=%s',trace,id,body.kind,module)
    audit(actor_label(user),'inject_lab_fault',str(id),body.kind)
    return {'id':id,'trace_id':trace,'title':title,'simulation':True}

@app.post('/api/ops/lab/reproduce')
def reproduce_lab_failure(body:FaultInput,user=Depends(admin)):
    """Real HTTP test response on isolated lab route; never breaks live HR endpoints."""
    if os.getenv('TALENTIQ_LAB_MODE','true').lower()!='true':raise HTTPException(403,'Lab mode disabled')
    if body.kind not in FAULTS:raise HTTPException(422,'Unknown fault')
    trace=str(uuid.uuid4())
    logger.error('LAB_REPRODUCED trace=%s kind=%s isolated_endpoint=ops/lab/reproduce',trace,body.kind)
    if body.kind=='search_latency':
        time.sleep(1.2)
        return JSONResponse({'lab':True,'kind':body.kind,'simulated_latency_ms':1200,'trace_id':trace},
            headers={'X-Lab-Trace-ID':trace})
    if body.kind=='resume_parser_error':
        return JSONResponse({'lab':True,'error':'Simulated OCR engine unavailable','trace_id':trace},
            status_code=422,headers={'X-Lab-Trace-ID':trace})
    return JSONResponse({'lab':True,'error':'Simulated '+body.kind+' on isolated lab route','trace_id':trace},
         status_code=500,headers={'X-Lab-Trace-ID':trace})

